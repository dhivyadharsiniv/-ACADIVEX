# ============================================================================
# ACADIVEX — Environment Configuration Example
# Copy this file to backend/.env and replace all placeholder values before running.
# NEVER commit your actual .env file or production credentials to Git.
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL with Prisma ORM)
DATABASE_URL="postgresql://your_db_user:your_db_password@localhost:5432/acadivex_db?schema=public"

# Runtime JSON Persistence Path (used when running local persistent store)
RUNTIME_DB_PATH="data/acadivex_runtime_db.json"

# Cryptographic Authentication Secrets (Replace with a strong random 64-byte string)
JWT_SECRET="replace_with_a_strong_random_jwt_secret_key"
JWT_EXPIRES_IN="7d"

# Optional Platform Super Admin Account (Separate from Institution Portals)
# Leave blank if not using the global Super Admin console, or set your own credentials
SUPER_ADMIN_EMAIL="superadmin@yourdomain.edu"
SUPER_ADMIN_PASSWORD="replace_with_strong_super_admin_password"

# Optional Default Initial Account Passwords (Used only when Admin omits password on creation)
DEFAULT_FACULTY_PASSWORD="replace_with_initial_faculty_password"
DEFAULT_STUDENT_PASSWORD="replace_with_initial_student_password"

# Optional Payment Gateway Configuration (Leave blank for UPI / Bank Transfer manual verification)
RAZORPAY_KEY_ID="your_razorpay_key_id_placeholder"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_placeholder"

# File & Logo Upload Storage Configuration
UPLOAD_DIR="uploads/avatars"
MAX_LOGO_SIZE_BYTES=2097152
